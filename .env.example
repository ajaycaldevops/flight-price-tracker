# Amadeus API Credentials
# Register for free at: https://developers.amadeus.com
AMADEUS_CLIENT_ID=your_amadeus_client_id_here
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret_here
AMADEUS_HOSTNAME=test  # Use "production" for live data (requires approval)

# Gmail SMTP Credentials
# Use a Gmail App Password (requires 2FA enabled):
# Google Account > Security > 2-Step Verification > App Passwords
SMTP_EMAIL=your_gmail_address@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here

# Flask
FLASK_SECRET_KEY=change_this_to_a_random_secret_key
